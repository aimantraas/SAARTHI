# LeadGen Backend - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# API Keys
# ============================================================

# SerpAPI key for Google search and AI mode
SERP_API_KEY=your_serpapi_key_here

# Apify API token for LinkedIn profile scraping
APIFY_API_TOKEN=your_apify_token_here

# EmailVerify.io API key for email verification
EMAIL_VERIFY_API_KEY=your_emailverify_key_here

# ============================================================
# Google Sheets
# ============================================================

# Google Spreadsheet ID (from the URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to Google OAuth2 credentials JSON file
GOOGLE_CREDENTIALS_PATH=credentials.json

# ============================================================
# Search Parameters (optional - can also be set via CLI)
# ============================================================

# Default companies to search (comma-separated)
# COMPANIES=Retail,Tech,Finance

# Default position to search for
# POSITION=Head operation

# Default country
# COUNTRY=India

# Default country code
# COUNTRY_CODE=IN

# ============================================================
# Web Server (optional)
# ============================================================

# HOST=0.0.0.0
# PORT=5000
# FLASK_DEBUG=0
# PRODUCTION=0
